# 1) Telegram: habla con @BotFather, crea un bot y pega el token
TELEGRAM_TOKEN=
# 2) Tu ID de Telegram (deja 0 la primera vez: el bot te lo dira al escribirle)
ALLOWED_USER_ID=0
# 3) Clave gratuita en https://console.groq.com/keys
GROQ_API_KEY=
# 4) Carpeta de tu vault de Obsidian (o la carpeta que sincronizas con Syncthing)
VAULT_PATH=/home/usuario/vault
